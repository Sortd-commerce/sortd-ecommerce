# Copy this file to .env and replace every secret before running the project.
# Never commit .env.
#
# ENVIRONMENT selects the runtime:
#   local       -> SQLite at db.sqlite3 unless DATABASE_URL is set.
#   production  -> PostgreSQL DATABASE_URL is required. DEBUG must be False.

ENVIRONMENT=local
DEBUG=True
SECRET_KEY=change-me-in-production
JWT_SIGNING_KEY=change-me-in-production-too
SERVICE_SIGNING_KEY=change-me-service-signing-key

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Local Docker (docker compose up -d):
# DATABASE_URL=postgres://sortd:sortd@127.0.0.1:5432/sortd
# Production (Neon, RDS, Render, Railway, ...). sslmode=require is added automatically.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/sortd
# DATABASE_CONN_MAX_AGE=60
# DATABASE_SSL_REQUIRE=True

# Set True only behind HTTPS. Local http development should stay False.
USE_HTTPS=False
# Number of trusted reverse proxies in front of the app. 0 ignores X-Forwarded-For.
NUM_PROXIES=0

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
SERVICE_TOKEN_MAX_SECONDS=300
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
SERVICE_TOKEN_ISSUERS=storefront,admin

# Rate limits. Periods: sec, min, hour, day.
THROTTLE_ANON=60/min
THROTTLE_USER=120/min
THROTTLE_AUTH=10/min
THROTTLE_SIGNUP=5/min
THROTTLE_VERIFY=10/min
THROTTLE_RESEND=3/min
THROTTLE_PASSWORD_RESET=5/min

PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Local: leave EMAIL_HOST empty to print magic links in the Django console.
# Set EMAIL_HOST locally to send real mail before you deploy.
# Production: SMTP is required. Resend example:
#   EMAIL_HOST=smtp.resend.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=resend
#   EMAIL_HOST_PASSWORD=re_your_api_key
#   EMAIL_USE_TLS=True
#   DEFAULT_FROM_EMAIL=Sortd <hello@your-verified-domain>
# SendGrid: EMAIL_HOST=smtp.sendgrid.net EMAIL_HOST_USER=apikey EMAIL_HOST_PASSWORD=<key>
# Amazon SES: EMAIL_HOST=email-smtp.<region>.amazonaws.com EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Sortd <noreply@localhost>
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Brevo (Anymail HTTP API). Use an API v3 key from SMTP & API → API Keys.
# Leave EMAIL_HOST empty while this is on. From-address must be a verified sender.
# BREVO_API_KEY=
# EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
# DEFAULT_FROM_EMAIL=Sortd <hello@your-verified-domain>

# Places / geocoding (server-side only; never expose these keys to the browser).
# Default when unset: LocationIQ if LOCATIONIQ_API_KEY is set, else Google if
# GOOGLE_MAPS_API_KEY is set, else fixture in local, else closed in production.
# GEOCODER_PROVIDER=locationiq
# LOCATIONIQ_API_KEY=pk....
# GOOGLE_MAPS_API_KEY=
# THROTTLE_PLACES=30/min

# Local filesystem fallback when these are empty. Required in production.
# Restricted Cloudinary API keys must allow the Create (upload) action.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Used to turn local /media/... paths into absolute image URLs for the Next apps.
PUBLIC_API_ORIGIN=http://127.0.0.1:8000
