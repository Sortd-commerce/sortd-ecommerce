API_BASE_URL=http://127.0.0.1:8000/api/v1
# Set true to require the backend-configured shared password before viewing the storefront.
STOREFRONT_PASSWORD_GATE_ENABLED=false
# Public storefront URL for server redirects after Stripe (must not be 0.0.0.0).
# STOREFRONT_URL=https://your-store.example
SERVICE_SIGNING_KEY=local-dev-service-signing-key-not-for-production
SERVICE_TOKEN_ISSUER=storefront
SERVICE_TOKEN_AUDIENCE=sortd-api

# Marketing / landing site (About Us footer link, etc.)
NEXT_PUBLIC_LANDING_BASE_URL=https://sortd-ecommerce.vercel.app

# Address autocomplete and geocoding stay on the Django API.
# Do not add NEXT_PUBLIC LocationIQ or Google Maps keys here.

# Stripe publishable key for card payments at checkout (pk_test_... or pk_live_...).
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
